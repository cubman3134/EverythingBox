// GENERATED at configure time by native/cmake/GenerateSecrets.cmake into the BUILD TREE.
// Do NOT edit, do NOT commit. Regenerated whenever a native/secrets/*.secrets file changes.
//
// Best-effort obfuscation (rolling XOR), NOT cryptography: it only keeps the plaintext dev
// credentials out of a `strings` scan of the shipped binary. Anyone holding the binary plus this
// source can trivially recover them. See native/secrets/README.md.
//
// One block per embedded provider credential VALUE. Each value's obfuscated blob is split in half
// across two arrays, so no single array in the binary holds a contiguous credential. A value that
// was absent (or blank) at configure time embeds as a single 0 byte with both lengths 0 — the
// provider then falls back to the user's addon settings and, absent those too, stays dormant.
// AddonContext::builtinCredential() joins the two halves + de-obfuscates on demand.
#pragma once

namespace eb_secrets {

// ScreenScraper developer credentials (software identity; the user's ssid/sspassword stay optional).
inline constexpr unsigned char kSS_DevId_A[]      = { @EB_SS_DEVID_ARRAY_A@ };
inline constexpr unsigned char kSS_DevId_B[]      = { @EB_SS_DEVID_ARRAY_B@ };
inline constexpr int           kSS_DevId_ALen     = @EB_SS_DEVID_LEN_A@;
inline constexpr int           kSS_DevId_BLen     = @EB_SS_DEVID_LEN_B@;

inline constexpr unsigned char kSS_DevPw_A[]      = { @EB_SS_DEVPW_ARRAY_A@ };
inline constexpr unsigned char kSS_DevPw_B[]      = { @EB_SS_DEVPW_ARRAY_B@ };
inline constexpr int           kSS_DevPw_ALen     = @EB_SS_DEVPW_LEN_A@;
inline constexpr int           kSS_DevPw_BLen     = @EB_SS_DEVPW_LEN_B@;

// TheGamesDB: a plain public API key.
inline constexpr unsigned char kTgdb_Key_A[]      = { @EB_TGDB_KEY_ARRAY_A@ };
inline constexpr unsigned char kTgdb_Key_B[]      = { @EB_TGDB_KEY_ARRAY_B@ };
inline constexpr int           kTgdb_Key_ALen     = @EB_TGDB_KEY_LEN_A@;
inline constexpr int           kTgdb_Key_BLen     = @EB_TGDB_KEY_LEN_B@;

// IGDB: Twitch developer client id + secret (an app access token is exchanged at runtime).
inline constexpr unsigned char kIgdb_Id_A[]       = { @EB_IGDB_ID_ARRAY_A@ };
inline constexpr unsigned char kIgdb_Id_B[]       = { @EB_IGDB_ID_ARRAY_B@ };
inline constexpr int           kIgdb_Id_ALen      = @EB_IGDB_ID_LEN_A@;
inline constexpr int           kIgdb_Id_BLen      = @EB_IGDB_ID_LEN_B@;

inline constexpr unsigned char kIgdb_Secret_A[]   = { @EB_IGDB_SECRET_ARRAY_A@ };
inline constexpr unsigned char kIgdb_Secret_B[]   = { @EB_IGDB_SECRET_ARRAY_B@ };
inline constexpr int           kIgdb_Secret_ALen  = @EB_IGDB_SECRET_LEN_A@;
inline constexpr int           kIgdb_Secret_BLen  = @EB_IGDB_SECRET_LEN_B@;

// SteamGridDB: a personal API key. A project-wide key is against the grain of their per-user model
// (see the addon's settings description), so this slot is normally left blank and the addon stays
// user-supplied; the mechanism exists so a build MAY embed one if the owner chooses.
inline constexpr unsigned char kSgdb_Key_A[]      = { @EB_SGDB_KEY_ARRAY_A@ };
inline constexpr unsigned char kSgdb_Key_B[]      = { @EB_SGDB_KEY_ARRAY_B@ };
inline constexpr int           kSgdb_Key_ALen     = @EB_SGDB_KEY_LEN_A@;
inline constexpr int           kSgdb_Key_BLen     = @EB_SGDB_KEY_LEN_B@;

} // namespace eb_secrets
