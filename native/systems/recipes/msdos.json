{
  "system": "msdos",
  "summary": "Drop a DOS game here as a ZIP or as its own folder. Nothing else: DOSBox-Pure reads the ZIP without unpacking it, and for a folder EverythingBox finds the program to run.",
  "firmwareFolder": "system",
  "folderIsGame": true,
  "executables": {
    "extensions": ["bat", "exe", "com"],
    "prefer": [],
    "avoid": [
      "install", "install2", "instalar", "setup", "config", "configur", "setsound",
      "uvconfig", "univbe", "readme", "read", "unzip", "uninstall", "uninstal",
      "dos4gw", "cwsdpmi", "deice", "regist", "order"
    ]
  },
  "cores": [
    {
      "core": "dosbox_pure",
      "options": {
        "dosbox_pure_conf": "inside"
      },
      "firmware": [],
      "content": [
        { "when": "archive", "present": "asIs" },
        { "when": "folder",  "present": "executable" },
        { "when": "file",    "present": "asIs" }
      ],
      "bootCommand": ""
    },
    {
      "core": "dosbox_core",
      "options": {
        "dosbox_core_machine": "svga_s3",
        "dosbox_core_mount_c_as": "content",
        "dosbox_core_cpu_cycles_mode": "fixed"
      },
      "firmware": [],
      "content": [
        { "when": "archive", "present": "extract" },
        { "when": "folder",  "present": "executable" },
        { "when": "file",    "present": "asIs" }
      ],
      "bootCommand": ""
    }
  ]
}
