<?xml version="1.0" encoding="UTF-8"?>
<!--
  iOS Info.plist template for the EverythingBox app bundle.

  WHY A CUSTOM TEMPLATE. Qt's stock iOS template (Qt's cmake/ios/Info.plist.app.in) has no
  CFBundleIconName, and iOS finds the app icon ONLY through that key plus a COMPILED asset
  catalog — it ignores .icns entirely and it ignores loose PNGs in the bundle. Without the key
  the springboard shows a blank/default tile no matter what is in Assets.xcassets. So this is a
  verbatim copy of Qt 6.8's template with CFBundleIconName added; everything else is unchanged
  so the Qt-managed keys keep behaving exactly as they would by default.

  HOW IT IS SUBSTITUTED. Qt's _qt_internal_copy_info_plist() honours a project-provided
  MACOSX_BUNDLE_INFO_PLIST and runs configure_file(@ONLY) over it — that is what fills in
  @qt_ios_launch_screen_plist_entry@ (drop that placeholder and the app loses its launch
  storyboard and runs letterboxed). CMake then runs its own pass for the ${MACOSX_BUNDLE_*}
  entries. $(PRODUCT_NAME) survives both passes untouched and is expanded by Xcode at build
  time — CMake's pass is not @ONLY, so a ${...} spelling here would be eaten instead.
-->
<!DOCTYPE plist PUBLIC "-//Apple Computer//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleInfoDictionaryVersion</key>
    <string>6.0</string>

    <key>CFBundlePackageType</key>
    <string>APPL</string>

    <key>CFBundleName</key>
    <string>${MACOSX_BUNDLE_BUNDLE_NAME}</string>

    <key>CFBundleDisplayName</key>
    <string>$(PRODUCT_NAME)</string>

    <key>CFBundleIdentifier</key>
    <string>${MACOSX_BUNDLE_GUI_IDENTIFIER}</string>

    <key>CFBundleExecutable</key>
    <string>${MACOSX_BUNDLE_EXECUTABLE_NAME}</string>

    <key>CFBundleVersion</key>
    <string>${MACOSX_BUNDLE_BUNDLE_VERSION}</string>

    <key>CFBundleShortVersionString</key>
    <string>${MACOSX_BUNDLE_SHORT_VERSION_STRING}</string>

    <key>CFBundleIconFile</key>
    <string>${MACOSX_BUNDLE_ICON_FILE}</string>

    <!-- The app-icon set inside Assets.xcassets. Must match
         XCODE_ATTRIBUTE_ASSETCATALOG_COMPILER_APPICON_NAME in native/CMakeLists.txt. -->
    <key>CFBundleIconName</key>
    <string>AppIcon</string>

    <key>CFBundleDevelopmentRegion</key>
    <string>$(DEVELOPMENT_LANGUAGE)</string>
    <key>CFBundleAllowMixedLocalizations</key>
    <true/>

    <key>LSRequiresIPhoneOS</key>
    <true/>

    <key>UILaunchStoryboardName</key>
    <string>@qt_ios_launch_screen_plist_entry@</string>

    <key>UISupportedInterfaceOrientations</key>
    <array>
        <string>UIInterfaceOrientationPortrait</string>
        <string>UIInterfaceOrientationPortraitUpsideDown</string>
        <string>UIInterfaceOrientationLandscapeLeft</string>
        <string>UIInterfaceOrientationLandscapeRight</string>
    </array>
</dict>
</plist>
