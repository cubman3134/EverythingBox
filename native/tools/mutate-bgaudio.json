{
  "build":    ["cmake", "--build", "build", "--config", "Release", "--target", "probe_bgaudio", "--parallel"],
  "test":     ["build/Release/probe_bgaudio.exe"],
  "artifact": "build/Release/probe_bgaudio.exe",
  "sentinel": "BGAUDIO-OK",
  "env":      { "QT_QPA_PLATFORM": "offscreen" },
  "mutants": [
    { "name": "the-media-kind-latch-is-read-before-the-count",
      "file": "native/src/media/BackgroundAudio.h",
      "find": "        if (s.queueCount <= 0) return false;   // no queue: the latch says nothing, whatever it still holds\n        return !s.videoLatch;",
      "replace": "        return !s.videoLatch;",
      "count": 1,
      "expect": "killed" },

    { "name": "an-emptied-queue-is-still-a-live-session",
      "file": "native/src/media/BackgroundAudio.h",
      "find": "        if (s.queueCount <= 0) return false;",
      "replace": "        if (s.queueCount < 0) return false;",
      "count": 1,
      "expect": "killed" },

    { "name": "a-film-is-left-playing-behind-the-ui",
      "file": "native/src/media/BackgroundAudio.h",
      "find": "        return !s.videoLatch;",
      "replace": "        return true;",
      "count": 1,
      "expect": "killed" },

    { "name": "leaving-the-page-still-stops-the-album",
      "file": "native/src/media/BackgroundAudio.h",
      "find": "        e.stopPlayer = false;",
      "replace": "        e.stopPlayer = true;",
      "count": 1,
      "expect": "killed" },

    { "name": "the-player-keeps-going-but-the-queue-is-thrown-away",
      "file": "native/src/media/BackgroundAudio.h",
      "find": "        e.clearQueue = false;                      // …so resume/consumption are flushed at the REAL end of",
      "replace": "        e.clearQueue = true;                       // …so resume/consumption are flushed at the REAL end of",
      "count": 1,
      "expect": "killed" },

    { "name": "the-lyric-cache-is-dropped-under-the-track-still-playing",
      "file": "native/src/media/BackgroundAudio.h",
      "find": "        e.keepLyrics = true;",
      "replace": "        e.keepLyrics = false;",
      "count": 1,
      "expect": "killed" },

    { "name": "the-music-plays-on-with-no-route-back-to-it",
      "file": "native/src/media/BackgroundAudio.h",
      "find": "        e.background = true;",
      "replace": "        e.background = false;",
      "count": 1,
      "expect": "killed" },

    { "name": "a-video-exit-no-longer-takes-the-pre-193-plan",
      "file": "native/src/media/BackgroundAudio.h",
      "find": "        if (!audioLive(s)) return Exit{};",
      "replace": "        if (false) return Exit{};",
      "count": 1,
      "expect": "killed" },

    { "name": "the-default-plan-stops-being-todays-behaviour",
      "file": "native/src/media/BackgroundAudio.h",
      "find": "        bool clearQueue = true;   // session_->clearQueue(): flushes resume + consumption, disarms gapless",
      "replace": "        bool clearQueue = false;  // session_->clearQueue(): flushes resume + consumption, disarms gapless",
      "count": 1,
      "expect": "killed" },

    { "name": "the-route-back-is-offered-on-the-page-it-would-open",
      "file": "native/src/media/BackgroundAudio.h",
      "find": "        return audioLive(s) && !pageVisible;",
      "replace": "        return audioLive(s);",
      "count": 1,
      "expect": "killed" },

    { "name": "the-route-back-ignores-whether-anything-is-playing",
      "file": "native/src/media/BackgroundAudio.h",
      "find": "        return audioLive(s) && !pageVisible;",
      "replace": "        return !pageVisible;",
      "count": 1,
      "expect": "killed" },

    { "name": "a-queue-that-ended-under-the-menu-row-still-reopens-a-page",
      "file": "native/src/media/BackgroundAudio.h",
      "find": "        if (!audioLive(s)) return Reopen::Nothing;",
      "replace": "        if (false) return Reopen::Nothing;",
      "count": 1,
      "expect": "killed" },

    { "name": "a-classic-fallback-session-is-sent-back-to-a-themed-page",
      "file": "native/src/media/BackgroundAudio.h",
      "find": "        return wasThemed ? Reopen::ThemedPage : Reopen::ClassicPlayerPage;",
      "replace": "        return Reopen::ThemedPage;",
      "count": 1,
      "expect": "killed" },

    { "name": "the-remembered-page-is-inverted",
      "file": "native/src/media/BackgroundAudio.h",
      "find": "        return wasThemed ? Reopen::ThemedPage : Reopen::ClassicPlayerPage;",
      "replace": "        return wasThemed ? Reopen::ClassicPlayerPage : Reopen::ThemedPage;",
      "count": 1,
      "expect": "killed" }
  ]
}
