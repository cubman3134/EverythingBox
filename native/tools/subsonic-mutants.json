{
  "build":    ["cmake", "--build", "build", "--config", "Release", "--target", "probe_subsonic", "--parallel"],
  "test":     ["build/Release/probe_subsonic.exe"],
  "artifact": "build/Release/probe_subsonic.exe",
  "sentinel": "SUBSONIC-OK",
  "env":      { "QT_QPA_PLATFORM": "offscreen" },
  "mutants": [
    { "name": "id-not-server-qualified",
      "file": "native/src/core/Subsonic.cpp",
      "find": "    return QStringLiteral(\"sub\") + us + serverId + us + kindWord(kind) + us + remoteId;",
      "replace": "    return QStringLiteral(\"sub\") + us + QStringLiteral(\"00000000-0000-4000-8000-000000000000\") + us + kindWord(kind) + us + remoteId;",
      "count": 1,
      "expect": "killed" },

    { "name": "id-remote-half-truncated-at-a-separator",
      "file": "native/src/core/Subsonic.cpp",
      "find": "    const QString remote = qualified.mid(c + 1);",
      "replace": "    const QString remote = qualified.mid(c + 1).section(us, 0, 0);",
      "count": 1,
      "expect": "killed" },

    { "name": "id-server-half-not-checked-for-a-uuid",
      "file": "native/src/core/Subsonic.cpp",
      "find": "    const QUuid u = QUuid::fromString(server);\n    if (u.isNull()) return r;",
      "replace": "    if (server.isEmpty()) return r;",
      "count": 1,
      "expect": "killed" },

    { "name": "id-kind-word-accepted-unchecked",
      "file": "native/src/core/Subsonic.cpp",
      "find": "    if (!kindFromWord(qualified.mid(b + 1, c - b - 1), k)) return r;",
      "replace": "    kindFromWord(qualified.mid(b + 1, c - b - 1), k);",
      "count": 1,
      "expect": "killed" },

    { "name": "auth-token-hashes-salt-before-password",
      "file": "native/src/core/Subsonic.cpp",
      "find": "    const QByteArray in = password.toUtf8() + salt.toUtf8();",
      "replace": "    const QByteArray in = salt.toUtf8() + password.toUtf8();",
      "count": 1,
      "expect": "killed" },

    { "name": "auth-empty-password-still-mints-a-token",
      "file": "native/src/core/Subsonic.cpp",
      "find": "    if (password.isEmpty() || salt.isEmpty()) return QString();",
      "replace": "    if (salt.isEmpty()) return QString();",
      "count": 1,
      "expect": "killed" },

    { "name": "envelope-a-missing-status-reads-as-success",
      "file": "native/src/core/Subsonic.cpp",
      "find": "    if (st == QLatin1String(\"ok\")) { e.status = Status::Ok; return e; }",
      "replace": "    if (st != QLatin1String(\"failed\")) { e.status = Status::Ok; return e; }",
      "count": 1,
      "expect": "killed" },

    { "name": "stream-salt-no-longer-per-track",
      "file": "native/src/core/Subsonic.cpp",
      "find": "    const QByteArray h = QCryptographicHash::hash(subject.toUtf8(), QCryptographicHash::Md5).toHex();",
      "replace": "    const QByteArray h = QCryptographicHash::hash(QByteArray(\"fixed\"), QCryptographicHash::Md5).toHex();",
      "count": 1,
      "expect": "killed" },

    { "name": "payload-a-directory-row-reaches-the-queue-as-audio",
      "file": "native/src/core/Subsonic.cpp",
      "find": "        if (n->attr(QStringLiteral(\"isDir\")) == QLatin1String(\"true\")) continue;",
      "replace": "        if (false) continue;",
      "count": 1,
      "expect": "killed" },

    { "name": "album-subtitle-reverts-to-an-unfetched-tracks-size",
      "file": "native/src/browse/MusicCatalogs.cpp",
      "find": "                                QObject::tr(\"%n track(s)\", \"\", b.trackCount),",
      "replace": "                                QObject::tr(\"%n track(s)\", \"\", int(b.tracks.size())),",
      "count": 1,
      "expect": "killed" },

    { "name": "artist-subtitle-invents-a-zero-track-count",
      "file": "native/src/browse/MusicCatalogs.cpp",
      "find": "                                  shownTracks > 0 ? QObject::tr(\"%n track(s)\", \"\", shownTracks) : QString() });",
      "replace": "                                  QObject::tr(\"%n track(s)\", \"\", shownTracks) });",
      "count": 1,
      "expect": "killed" },

    { "name": "servers-door-appears-with-no-servers-configured",
      "file": "native/src/browse/MusicCatalogs.cpp",
      "find": "    if (musicServerCount > 0) cat.items.push_back(musicServersDoor(musicServerCount));\n\n    for (const MusicLibrary::Artist& a : idx.artists)",
      "replace": "    if (musicServerCount >= 0) cat.items.push_back(musicServersDoor(musicServerCount));\n\n    for (const MusicLibrary::Artist& a : idx.artists)",
      "count": 1,
      "expect": "killed" },

    { "name": "cold-cache-adopt-lands-in-the-wrong-bucket",
      "file": "native/src/core/Subsonic.cpp",
      "find": "    const QString artistKey = qualify(serverId, Kind::Artist, artistRemote);",
      "replace": "    const QString artistKey = qualify(serverId, Kind::Artist, QStringLiteral(\"one\"));",
      "count": 1,
      "expect": "killed" },

    { "name": "local-count-fields-left-unset-by-buildIndex",
      "file": "native/src/core/MusicLibrary.cpp",
      "find": "        a.albumCount = int(a.albums.size());\n        for (Album& b : a.albums) b.trackCount = int(b.tracks.size());",
      "replace": "        a.albumCount = int(a.albums.size());",
      "count": 1,
      "expect": "killed" }
  ]
}
