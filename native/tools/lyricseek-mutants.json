{
  "build":    ["cmake", "--build", "build", "--config", "Release", "--target", "probe_lyricseek", "--parallel"],
  "test":     ["build/Release/probe_lyricseek.exe"],
  "artifact": "build/Release/probe_lyricseek.exe",
  "sentinel": "LYRICSEEK-OK",
  "env":      { "QT_QPA_PLATFORM": "offscreen" },
  "mutants": [
    { "name": "seek-ignores-the-offset",
      "file": "native/src/media/LyricSeek.h",
      "find": "return std::max(0.0, ly.lines[line].timeSec + clampOffset(offsetSec));",
      "replace": "return std::max(0.0, ly.lines[line].timeSec);",
      "count": 1,
      "expect": "killed" },

    { "name": "seek-subtracts-the-offset-instead",
      "file": "native/src/media/LyricSeek.h",
      "find": "return std::max(0.0, ly.lines[line].timeSec + clampOffset(offsetSec));",
      "replace": "return std::max(0.0, ly.lines[line].timeSec - clampOffset(offsetSec));",
      "count": 1,
      "expect": "killed" },

    { "name": "seek-out-of-range-answers-zero",
      "file": "native/src/media/LyricSeek.h",
      "find": "if (!canSeek(ly) || line < 0 || line >= ly.lines.size()) return -1.0;",
      "replace": "if (!canSeek(ly) || line < 0 || line >= ly.lines.size()) return 0.0;",
      "count": 1,
      "expect": "killed" },

    { "name": "seek-offered-on-an-unsynced-sheet",
      "file": "native/src/media/LyricSeek.h",
      "find": "return ly.synced && !ly.lines.isEmpty();",
      "replace": "return !ly.lines.isEmpty();",
      "count": 1,
      "expect": "killed" },

    { "name": "seek-offered-on-an-empty-set",
      "file": "native/src/media/LyricSeek.h",
      "find": "return ly.synced && !ly.lines.isEmpty();",
      "replace": "return ly.synced;",
      "count": 1,
      "expect": "killed" },

    { "name": "highlight-adds-the-offset-instead-of-subtracting",
      "file": "native/src/media/LyricSeek.h",
      "find": "return LrcLyrics::lineIndexAtTime(ly, posSec - clampOffset(offsetSec));",
      "replace": "return LrcLyrics::lineIndexAtTime(ly, posSec + clampOffset(offsetSec));",
      "count": 1,
      "expect": "killed" },

    { "name": "highlight-ignores-the-offset",
      "file": "native/src/media/LyricSeek.h",
      "find": "return LrcLyrics::lineIndexAtTime(ly, posSec - clampOffset(offsetSec));",
      "replace": "return LrcLyrics::lineIndexAtTime(ly, posSec);",
      "count": 1,
      "expect": "killed" },

    { "name": "highlight-runs-on-an-unsynced-sheet",
      "file": "native/src/media/LyricSeek.h",
      "find": "if (!canSeek(ly)) return -1;",
      "replace": "if (false) return -1;",
      "count": 1,
      "expect": "killed" },

    { "name": "offset-not-snapped-to-the-half-second-grid",
      "file": "native/src/media/LyricSeek.h",
      "find": "double snapped = std::round(offsetSec / kStepSec) * kStepSec;",
      "replace": "double snapped = offsetSec;",
      "count": 1,
      "expect": "killed" },

    { "name": "offset-clamp-removed",
      "file": "native/src/media/LyricSeek.h",
      "find": "snapped = std::max(-kMaxOffsetSec, std::min(kMaxOffsetSec, snapped));",
      "replace": "snapped = std::max(-1e9, std::min(1e9, snapped));",
      "count": 1,
      "expect": "killed" },

    { "name": "offset-nan-passed-through",
      "file": "native/src/media/LyricSeek.h",
      "find": "if (std::isnan(offsetSec)) return 0.0;",
      "replace": "if (false) return 0.0;",
      "count": 1,
      "expect": "killed" },

    { "name": "nudge-steps-a-whole-second",
      "file": "native/src/media/LyricSeek.h",
      "find": "return clampOffset(clampOffset(offsetSec) + steps * kStepSec);",
      "replace": "return clampOffset(clampOffset(offsetSec) + steps * 1.0);",
      "count": 1,
      "expect": "killed" },

    { "name": "nudge-steps-the-wrong-way",
      "file": "native/src/media/LyricSeek.h",
      "find": "return clampOffset(clampOffset(offsetSec) + steps * kStepSec);",
      "replace": "return clampOffset(clampOffset(offsetSec) - steps * kStepSec);",
      "count": 1,
      "expect": "killed" },

    { "name": "negative-zero-not-folded",
      "file": "native/src/media/LyricSeek.h",
      "find": "return snapped == 0.0 ? 0.0 : snapped;",
      "replace": "return snapped;",
      "count": 1,
      "expect": "killed" },

    { "name": "describe-drops-the-sign",
      "file": "native/src/media/LyricSeek.h",
      "find": "return (v > 0.0 ? QStringLiteral(\"+\") : QString::fromUtf8(\"\\xE2\\x88\\x92\")) + mag + QStringLiteral(\" s\");",
      "replace": "return mag + QStringLiteral(\" s\");",
      "count": 1,
      "expect": "killed" }
  ]
}
