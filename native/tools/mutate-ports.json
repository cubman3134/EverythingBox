{
  "build":    ["cmake", "--build", "build", "--config", "Release", "--target", "probe_ports", "--parallel"],
  "test":     ["build/Release/probe_ports.exe"],
  "artifact": "build/Release/probe_ports.exe",
  "sentinel": "PORTS-OK",
  "mutants": [
    { "name": "match-ignores-the-system",
      "file": "native/src/core/NativePorts.h",
      "find": "        if (port.port.system.compare(systemId.trimmed(), Qt::CaseInsensitive) != 0) return false;",
      "replace": "        if (false) return false;",
      "count": 1,
      "expect": "killed" },

    { "name": "match-ignores-the-title",
      "file": "native/src/core/NativePorts.h",
      "find": "        if (!titleHit) return false;",
      "replace": "        titleHit = true;",
      "count": 1,
      "expect": "killed" },

    { "name": "title-match-is-a-prefix-not-an-equality",
      "file": "native/src/core/NativePorts.h",
      "find": "        bool titleHit = (id.key == normalizeTitle(port.port.title));",
      "replace": "        bool titleHit = normalizeTitle(port.port.title).startsWith(id.key.left(12));",
      "count": 1,
      "expect": "killed" },

    { "name": "region-refusal-does-nothing",
      "file": "native/src/core/NativePorts.h",
      "find": "            if (!ok) return false;",
      "replace": "            if (false) return false;",
      "count": 1,
      "expect": "killed" },

    { "name": "revision-refusal-does-nothing",
      "file": "native/src/core/NativePorts.h",
      "find": "        if (!port.port.revisions.isEmpty() && !id.revision.isEmpty()\n            && !port.port.revisions.contains(id.revision)) return false;",
      "replace": "        if (false) return false;",
      "count": 1,
      "expect": "killed" },

    { "name": "a-non-port-entry-matches-too",
      "file": "native/src/core/EmulatorRegistry.h",
      "find": "    bool isNativePort() const { return !port.title.isEmpty(); }",
      "replace": "    bool isNativePort() const { return true; }",
      "count": 1,
      "expect": "killed" },

    { "name": "normalize-keeps-the-leading-article",
      "file": "native/src/core/NativePorts.h",
      "find": "        s.replace(leading, QString());",
      "replace": "        (void)leading;",
      "count": 1,
      "expect": "killed" },

    { "name": "normalize-keeps-the-no-intro-inversion",
      "file": "native/src/core/NativePorts.h",
      "find": "        s.replace(inverted, QString());",
      "replace": "        (void)inverted;",
      "count": 1,
      "expect": "killed" },

    { "name": "normalize-keeps-the-dump-metadata",
      "file": "native/src/core/NativePorts.h",
      "find": "        if (cut >= 0) s = s.left(cut);",
      "replace": "        (void)cut;",
      "count": 1,
      "expect": "killed" },

    { "name": "extension-strip-has-no-length-bound",
      "file": "native/src/core/NativePorts.h",
      "find": "        if (ext.isEmpty() || ext.size() > 4) return name;",
      "replace": "        if (ext.isEmpty()) return name;",
      "count": 1,
      "expect": "killed" },

    { "name": "extension-strip-accepts-a-non-alphanumeric-tail",
      "file": "native/src/core/NativePorts.h",
      "find": "        for (const QChar c : ext) if (!c.isLetterOrNumber()) return name;",
      "replace": "        for (const QChar c : ext) if (false) return name;",
      "count": 1,
      "expect": "killed" },

    { "name": "a-language-list-reads-as-a-region",
      "file": "native/src/core/NativePorts.h",
      "find": "        if (t == QStringLiteral(\"world\") || t == QStringLiteral(\"w\")) return QStringLiteral(\"world\");",
      "replace": "        if (!t.isEmpty()) return t;",
      "count": 1,
      "expect": "killed" },

    { "name": "every-rom-mode-claims-to-be-supported",
      "file": "native/src/core/NativePorts.h",
      "find": "    inline bool romModeSupported(const QString& mode) { return mode == QStringLiteral(\"menu\"); }",
      "replace": "    inline bool romModeSupported(const QString& mode) { return !mode.isNull() || true; }",
      "count": 1,
      "expect": "killed" },

    { "name": "releases-fallback-fires-on-any-url",
      "file": "native/src/core/EmulatorRegistry.h",
      "find": "        if (!u.endsWith(QStringLiteral(\"/releases/latest\"), Qt::CaseInsensitive)) return QString();",
      "replace": "        if (false) return QString();",
      "count": 1,
      "expect": "killed" },

    { "name": "newest-release-takes-a-draft",
      "file": "native/src/core/EmulatorRegistry.h",
      "find": "            if (o.value(QStringLiteral(\"draft\")).toBool()) continue;",
      "replace": "            if (false) continue;",
      "count": 1,
      "expect": "killed" },

    { "name": "the-shipped-catalog-is-not-embedded",
      "file": "native/resources/ports.qrc",
      "find": "<file alias=\"n64recomp.json\">../ports/n64recomp.json</file>",
      "replace": "<file alias=\"not-the-name-the-code-asks-for.json\">../ports/n64recomp.json</file>",
      "count": 1,
      "expect": "killed" }
  ]
}
