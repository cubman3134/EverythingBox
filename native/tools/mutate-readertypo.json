{
  "build":    ["cmake", "--build", "build", "--config", "Release", "--target", "probe_readertypography", "--parallel"],
  "test":     ["build/Release/probe_readertypography.exe"],
  "artifact": "build/Release/probe_readertypography.exe",
  "sentinel": "READERTYPO-OK",
  "env":      { "QT_QPA_PLATFORM": "offscreen" },
  "mutants": [
    { "name": "sepia-text-wrong",
      "file": "native/src/ebook/ReaderTypography.h",
      "find": "case Theme::Sepia:     return { QStringLiteral(\"#5B4636\"), QStringLiteral(\"#F4ECD8\") };",
      "replace": "case Theme::Sepia:     return { QStringLiteral(\"#000000\"), QStringLiteral(\"#F4ECD8\") };",
      "count": 1,
      "expect": "killed" },
    { "name": "trueblack-bg-not-black",
      "file": "native/src/ebook/ReaderTypography.h",
      "find": "case Theme::TrueBlack: return { QStringLiteral(\"#C8C8C8\"), QStringLiteral(\"#000000\") };",
      "replace": "case Theme::TrueBlack: return { QStringLiteral(\"#C8C8C8\"), QStringLiteral(\"#202124\") };",
      "count": 1,
      "expect": "killed" },
    { "name": "light-default-fallthrough-changed",
      "file": "native/src/ebook/ReaderTypography.h",
      "find": "default:               return { QStringLiteral(\"#1A1A1A\"), QStringLiteral(\"#FFFFFF\") };",
      "replace": "default:               return { QStringLiteral(\"#1A1A1A\"), QStringLiteral(\"#EEEEEE\") };",
      "count": 1,
      "expect": "killed" },
    { "name": "clampsize-floor-dropped",
      "file": "native/src/ebook/ReaderTypography.h",
      "find": "inline int clampSize(int pt)      { return qBound(8,   pt,  40);  }",
      "replace": "inline int clampSize(int pt)      { return qBound(1,   pt,  40);  }",
      "count": 1,
      "expect": "killed" },
    { "name": "clampsize-ceil-dropped",
      "file": "native/src/ebook/ReaderTypography.h",
      "find": "inline int clampSize(int pt)      { return qBound(8,   pt,  40);  }",
      "replace": "inline int clampSize(int pt)      { return qBound(8,   pt,  400);  }",
      "count": 1,
      "expect": "killed" },
    { "name": "clampspacing-floor-dropped",
      "file": "native/src/ebook/ReaderTypography.h",
      "find": "inline int clampSpacing(int pct)  { return qBound(100, pct, 250); }",
      "replace": "inline int clampSpacing(int pct)  { return qBound(10, pct, 250); }",
      "count": 1,
      "expect": "killed" },
    { "name": "clampmargin-ceil-dropped",
      "file": "native/src/ebook/ReaderTypography.h",
      "find": "inline int clampMargin(int pct)   { return qBound(0,   pct, 25);  }",
      "replace": "inline int clampMargin(int pct)   { return qBound(0,   pct, 250);  }",
      "count": 1,
      "expect": "killed" },
    { "name": "resolve-justify-forced-false",
      "file": "native/src/ebook/ReaderTypography.h",
      "find": "r.justify        = s.justify;",
      "replace": "r.justify        = false;",
      "count": 1,
      "expect": "killed" },
    { "name": "resolve-family-not-trimmed",
      "file": "native/src/ebook/ReaderTypography.h",
      "find": "r.fontFamily     = s.fontFamily.trimmed();",
      "replace": "r.fontFamily     = s.fontFamily;",
      "count": 1,
      "expect": "killed" },
    { "name": "themefromint-outrange-not-light",
      "file": "native/src/ebook/ReaderTypography.h",
      "find": "        default: return Theme::Light;\n        }\n    }\n}",
      "replace": "        default: return Theme::Dark;\n        }\n    }\n}",
      "count": 1,
      "expect": "killed" }
  ]
}
