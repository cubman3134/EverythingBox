# Build output (CMake)
/build/
/build-clean/
/build-ios/
/build-ios-dev/
/native/build/
/native/**/build/

# Claude Code local session settings
/.claude/

# IDE / editor
.vs/
.vscode/
*.user

# OS
.DS_Store
Thumbs.db

# Cloudflare Wrangler local cache/state
.wrangler/
node_modules/

# Misc
*.log

# Superpowers scratch (audit screenshots, spike dumps, SDD working files)
.superpowers/

# Theme/addon registries are published as their own GitHub repos (nested .git);
# don't embed them in this repo.
/native/registry/

# Embedded provider dev credentials: the secrets files are build-time-only and
# must never be committed. Keep the format/instructions README, drop everything else.
/native/secrets/*
!/native/secrets/README.md


# Python bytecode (native/tools/*.py helpers)
__pycache__/
*.pyc

# Screenshots the UI-test harness writes to the working directory, which is the repo root.
# 224 of these (72 MB) were swept into a merge commit by a `git add -A` during conflict
# resolution — the rule against stray PNGs in the root existed, and one `add -A` beat it.
# ROOT ONLY (the leading slash): images that belong to the app, the themes, the platform
# icon sets and the docs live in subdirectories and are unaffected. Evidence worth keeping
# goes to docs/superpowers/verification/ deliberately, not by being left lying around.
/*.png
/*.jpg
/*.jpeg
/*.gif
